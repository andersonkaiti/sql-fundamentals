{
  "name": "sql-fundamentals",
  "scripts": {
    "prepare": "husky"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.5.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "commitlint-config-gitmoji": "^2.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional",
      "gitmoji"
    ]
  },
  "lint-staged": {
    ".*": [
      "biome check --write"
    ]
  }
}
